{
  "name": "emass-mcp",
  "version": "0.1.0",
  "description": "MCP server for the eMASS REST API, generated from MITRE's eMASS OpenAPI specification",
  "license": "MIT",
  "type": "module",
  "bin": {
    "emass-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "prepare": "tsc -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "undici": "^8.12.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
